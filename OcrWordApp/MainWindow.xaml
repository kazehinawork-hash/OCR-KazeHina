<ui:FluentWindow x:Class="OcrWordApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OCR Đề Thi Sang Microsoft Word HTML" 
        Height="800" Width="1180" 
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Grid>
        <Grid.RowDefinitions>
            <!-- TitleBar Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Container -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP TITLEBAR -->
        <ui:TitleBar Grid.Row="0">
            <ui:TitleBar.Header>
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#252542" CornerRadius="12" Padding="12,4" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="0.8">
                            <TextBlock Text="OCR KazeHina" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Busy Indicator Badge on TitleBar -->
                    <StackPanel x:Name="BusyBadge" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitleBusy" Text="Đang xử lý..." FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- UNIFIED GLASS CONTAINER (Theme LiquidGlass) -->
        <Border x:Name="MainGlassContainer" Grid.Row="1" Margin="8,0,8,8" CornerRadius="12" ClipToBounds="True"
                BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlassBackgroundBrush}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Width="{Binding ActualWidth, ElementName=MainGlassContainer}"
                                Height="{Binding ActualHeight, ElementName=MainGlassContainer}"
                                CornerRadius="12" Background="Black"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Settings Header Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main workspace (File List + Preview/Info) -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. SETTINGS BAR (LiquidGlass Style) -->
                <Border Grid.Row="0" Margin="14,14,14,10" Padding="16,12" 
                        Background="{DynamicResource GlassElementBackgroundBrush}" 
                        BorderBrush="{DynamicResource GlassGradientBorderBrush}" 
                        BorderThickness="0.8" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- API Key -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Gemini API Key:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="(Tự động lưu trữ)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ui:PasswordBox x:Name="TxtApiKey" Grid.Column="1" Margin="8,0,20,0" VerticalAlignment="Center"
                                        PlaceholderText="Dán khóa Gemini API Key vào đây..."
                                        Style="{StaticResource InteractiveTextBox}"
                                        PasswordChanged="TxtApiKey_PasswordChanged"/>

                        <!-- Model Selection with Auto-Scan -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Mô hình AI:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="(Tự quét từ API)" FontSize="10" Foreground="#38BDF8"/>
                        </StackPanel>

                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CmbModel" Grid.Column="0" Height="36" VerticalContentAlignment="Center"/>

                            <Button x:Name="BtnRefreshModels" Grid.Column="1" Margin="8,0,0,0" Height="36" Padding="12,0"
                                    ToolTip="Quét lại danh sách mô hình từ API Key"
                                    Background="{DynamicResource GlassButtonNormalBrush}"
                                    BorderBrush="{DynamicResource GlassGradientBorderBrush}"
                                    BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold"
                                    Cursor="Hand" Click="BtnRefreshModels_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Quét" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. WORKSPACE GRID -->
                <Grid Grid.Row="1" Margin="14,0,14,10">
                    <Grid.ColumnDefinitions>
                        <!-- Left: File Management List -->
                        <ColumnDefinition Width="3*"/>
                        <!-- Right: Standard & Format Preview Guidelines -->
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT CARD: File List -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="14"
                            Background="{DynamicResource GlassElementBackgroundBrush}"
                            BorderBrush="{DynamicResource GlassGradientBorderBrush}"
                            BorderThickness="0.8" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="Auto"/> <!-- Button Toolbar -->
                                <RowDefinition Height="*"/>    <!-- File ListBox -->
                                <RowDefinition Height="Auto"/> <!-- Convert Button -->
                            </Grid.RowDefinitions>

                            <!-- Title Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="18" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                <TextBlock Text="Danh Sách Trang / Ảnh Đã Chụp" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Button Toolbar (WrapPanel tự xuống dòng mượt mà nếu thiếu chỗ, không bao giờ đè chữ) -->
                            <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
                                <ui:Button Content="Dán Ảnh (Ctrl+V)" Padding="12,6" Margin="0,0,6,6"
                                           Style="{StaticResource InteractiveButtonNeon}"
                                           Cursor="Hand" Click="BtnPasteClipboard_Click"/>
                                <Button Content="Thêm Ảnh" Padding="8,6" Margin="0,0,6,6"
                                        Background="{DynamicResource GlassButtonNormalBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                                        Foreground="White" Cursor="Hand" Click="BtnAddImages_Click"/>
                                <Button Content="Thêm PDF" Padding="8,6" Margin="0,0,6,6"
                                        Background="{DynamicResource GlassButtonNormalBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                                        Foreground="White" Cursor="Hand" Click="BtnAddPdf_Click"/>
                                <Button Content="▲ Lên" ToolTip="Di chuyển trang lên trên" Padding="8,6" Margin="0,0,4,6"
                                        Background="{DynamicResource GlassButtonNormalBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                                        Foreground="#38BDF8" FontWeight="SemiBold" Cursor="Hand" Click="BtnMoveUp_Click"/>
                                <Button Content="▼ Xuống" ToolTip="Di chuyển trang xuống dưới" Padding="8,6" Margin="0,0,6,6"
                                        Background="{DynamicResource GlassButtonNormalBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                                        Foreground="#38BDF8" FontWeight="SemiBold" Cursor="Hand" Click="BtnMoveDown_Click"/>
                                <Button Content="Xóa" ToolTip="Xóa mục đã chọn" Padding="8,6" Margin="0,0,6,6"
                                        Background="{DynamicResource GlassButtonNormalBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                                        Foreground="#F87171" Cursor="Hand" Click="BtnRemoveSelected_Click"/>
                                <Button Content="Dọn hết" ToolTip="Xóa toàn bộ danh sách" Padding="8,6" Margin="0,0,0,6"
                                        Background="{DynamicResource GlassButtonNormalBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                                        Foreground="#94A3B8" Cursor="Hand" Click="BtnClearAll_Click"/>
                            </WrapPanel>

                            <!-- File ListBox With Thumbnails -->
                            <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource GlassElementBackground2Brush}" BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.8">
                                <Grid>
                                    <ListBox x:Name="LstFiles" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="6" SelectionChanged="LstFiles_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,3" CornerRadius="8" 
                                                        Background="{DynamicResource GlassButtonNormalBrush}" 
                                                        BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="0.8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Thứ tự trang -->
                                                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IndexNumber}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Thumbnail ảnh xem nhanh -->
                                                        <Border Grid.Column="1" Width="56" Height="46" CornerRadius="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Thông tin tệp -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding FileSizeText}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Empty placeholder text -->
                                    <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="36" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Kéo thả ảnh / PDF hoặc bấm Ctrl+V để dán ảnh chụp màn hình" FontSize="13" Foreground="#94A3B8" Margin="0,8,0,2" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Hỗ trợ dán trực tiếp từ phím tắt Windows (Win + Shift + S rồi Ctrl+V)" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action Convert Button (Neon / Glass Primary) -->
                            <ui:Button x:Name="BtnConvert" Grid.Row="3" Margin="0,12,0,0" Height="48"
                                       Content="Bắt đầu"
                                       FontSize="15" FontWeight="Bold"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Style="{StaticResource InteractiveButtonNeon}"
                                       Click="BtnConvert_Click"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT CARD: High Resolution Image Preview Panel -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="14"
                            Background="{DynamicResource GlassElementBackgroundBrush}"
                            BorderBrush="{DynamicResource GlassGradientBorderBrush}"
                            BorderThickness="0.8" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Image24" Foreground="#38BDF8" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Xem Trước Ảnh (Preview)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtPreviewInfo" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </DockPanel>

                            <!-- Preview Image Display Box with Zoom/Pan container -->
                            <Border Grid.Row="1" CornerRadius="8" Background="#0B0F19" BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.8" ClipToBounds="True">
                                <Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                                    </ScrollViewer>

                                    <!-- Placeholder when no image is selected -->
                                    <StackPanel x:Name="PreviewEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ImageOff24" FontSize="40" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Chưa chọn ảnh nào để xem trước" Foreground="#94A3B8" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Nhấp vào một ảnh trong danh sách bên trái để phóng to" Foreground="#64748B" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. FOOTER STATUS BAR -->
                <Border Grid.Row="2" Background="{DynamicResource GlassElementBackground2Brush}" 
                        BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0,0.8,0,0" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info20" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtStatus" Text="Sẵn sàng. Hãy thêm tài liệu để bắt đầu." 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ProgressBar x:Name="PrgBar" Grid.Column="1" Height="6" IsIndeterminate="False" Visibility="Hidden" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
